# Cloudflare Zero Trust Topology Mapper
#
# Option A (recommended): Skip this file entirely and use wrangler:
#   wrangler login
#   python main.py
#
# Option B: Set these variables:

# Required: API token with Zero Trust read permissions
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-api-token-here

# Optional: Auto-discovered from your token if omitted
# Only needed if your token has access to multiple accounts
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# Optional: Enable debug logging
# DEBUG=true

# Docker/server only: Bearer token for /regenerate endpoint
# REGEN_AUTH_TOKEN=your-secret-token
